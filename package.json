{
  "name": "sentinel-gateway",
  "version": "1.0.0",
  "description": "Distributed Rate Limiter & API Gateway with zero race-condition drift and L1 fallback",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('src/limiter/scripts', 'dist/limiter/scripts', {recursive: true, force: true});\"",
    "start": "node dist/index.js",
    "dev": "tsx watch --include config/config.yaml src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx test/load/benchmark.ts",
    "cli": "tsx src/cli.ts",
    "fetch": "tsx src/cli.ts"
  },
  "keywords": [
    "rate-limiter",
    "api-gateway",
    "redis",
    "lua",
    "token-bucket",
    "sliding-window",
    "leaky-bucket",
    "circuit-breaker",
    "fastify"
  ],
  "author": "SentinelGW Team",
  "license": "Apache-2.0",
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "js-yaml": "^4.1.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
